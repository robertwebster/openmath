    "id": "integration-techniques-worked-1",
    "title": "Integration by parts — choosing $u$ and $dv$",
    "difficulty": 1,
    "problem": "Evaluate $\\displaystyle\\int_0^1 x^2 e^x\\,dx$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Apply integration by parts, $\\int u\\,dv = uv - \\int v\\,du$, with $u = x^2$, $dv = e^x\\,dx$.",
        "working": "$du = 2x\\,dx$, $v = e^x$. $\\int_0^1 x^2 e^x\\,dx = \\Big[x^2 e^x\\Big]_0^1 - 2\\int_0^1 x e^x\\,dx = e - 2\\int_0^1 x e^x\\,dx$"
      },
      {
        "step": 2,
        "instruction": "Apply integration by parts a second time to $\\int_0^1 xe^x\\,dx$, with $u = x$, $dv = e^x\\,dx$.",
        "working": "$\\int_0^1 x e^x\\,dx = \\Big[xe^x\\Big]_0^1 - \\int_0^1 e^x\\,dx = e - \\Big[e^x\\Big]_0^1 = e - (e-1) = 1$"
      },
      {
        "step": 3,
        "instruction": "Combine the results.",
        "working": "$\\int_0^1 x^2 e^x\\,dx = e - 2(1) = e - 2 \\approx 0.72$"
      }
    ],
    "answer": "$\\displaystyle\\int_0^1 x^2 e^x\\,dx = e-2 \\approx 0.72$."
  },
