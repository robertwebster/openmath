    "difficulty": 3,
    "problem": "Evaluate $\\displaystyle\\int_0^{\\pi/2} \\frac{1}{2 + \\cos x}\\,dx$ using $t = \\tan\\!\\left(\\tfrac{x}{2}\\right)$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Write $\\cos x$ and $dx$ in terms of $t$, and convert the limits.",
        "working": "$\\cos x = \\dfrac{1-t^2}{1+t^2}$, $dx = \\dfrac{2}{1+t^2}\\,dt$. When $x = 0$, $t = 0$; when $x = \\pi/2$, $t = 1$."
      },
      {
        "step": 2,
        "instruction": "Substitute into the integral.",
        "working": "$\\int_0^1 \\frac{1}{2 + \\frac{1-t^2}{1+t^2}} \\cdot \\frac{2}{1+t^2}\\,dt = \\int_0^1 \\frac{1+t^2}{2(1+t^2) + (1-t^2)} \\cdot \\frac{2}{1+t^2}\\,dt$"
      },
      {
        "step": 3,
        "instruction": "Simplify the integrand.",
        "working": "$= \\int_0^1 \\frac{2}{t^2 + 3}\\,dt$"
      },
      {
        "step": 4,
        "instruction": "Integrate using the standard arctangent form and evaluate.",
        "working": "$= \\frac{2}{\\sqrt{3}}\\Big[\\arctan\\!\\left(\\tfrac{t}{\\sqrt{3}}\\right)\\Big]_0^1 = \\frac{2}{\\sqrt{3}} \\cdot \\frac{\\pi}{6} = \\frac{\\pi}{3\\sqrt{3}} \\approx 0.605$"
      }
    ],
    "answer": "$\\displaystyle\\int_0^{\\pi/2} \\frac{1}{2+\\cos x}\\,dx = \\frac{\\pi}{3\\sqrt{3}} \\approx 0.605$."
  }
