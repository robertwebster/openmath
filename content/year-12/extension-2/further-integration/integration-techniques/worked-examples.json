    "difficulty": 2,
    "problem": "Evaluate $\\displaystyle\\int_1^2 \\frac{1}{x(x+1)^2}\\,dx$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Set up the partial fraction decomposition and clear denominators.",
        "working": "$\\dfrac{1}{x(x+1)^2} = \\dfrac{A}{x} + \\dfrac{B}{x+1} + \\dfrac{C}{(x+1)^2}$. Multiplying both sides by $x(x+1)^2$: $1 = A(x+1)^2 + Bx(x+1) + Cx$"
      },
      {
        "step": 2,
        "instruction": "Find $A$, $B$ and $C$ by substituting convenient values and comparing coefficients.",
        "working": "Setting $x = 0$: $1 = A$. Setting $x = -1$: $1 = -C$, so $C = -1$. Comparing coefficients of $x^2$: $0 = A + B$, so $B = -1$."
      },
      {
        "step": 3,
        "instruction": "Write the decomposition.",
        "working": "$\\dfrac{1}{x(x+1)^2} = \\dfrac{1}{x} - \\dfrac{1}{x+1} - \\dfrac{1}{(x+1)^2}$"
      },
      {
        "step": 4,
        "instruction": "Integrate and evaluate between the limits.",
        "working": "$\\left[\\ln x - \\ln(x+1) + \\dfrac{1}{x+1}\\right]_1^2 = \\left(\\ln 2 - \\ln 3 + \\dfrac{1}{3}\\right) - \\left(0 - \\ln 2 + \\dfrac{1}{2}\\right) = \\ln\\dfrac{4}{3} - \\dfrac{1}{6} \\approx 0.12$"
      }
    ],
    "answer": "$\\displaystyle\\int_1^2 \\frac{1}{x(x+1)^2}\\,dx = \\ln\\frac{4}{3}-\\frac{1}{6} \\approx 0.12$."
  },
