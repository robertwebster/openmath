    "id": "complex-polar-worked-1",
    "title": "Converting to polar form",
    "difficulty": 1,
    "problem": "Write $z = -1+\\sqrt{3}\\,i$ in polar form.",
    "steps": [
      {
        "step": 1,
        "instruction": "Find the modulus.",
        "working": "$r = |z| = \\sqrt{(-1)^2+(\\sqrt{3})^2} = \\sqrt{1+3} = 2$"
      },
      {
        "step": 2,
        "instruction": "Find the reference angle.",
        "working": "Reference angle: $\\arctan\\!\\left(\\dfrac{\\sqrt{3}}{1}\\right) = 60°$"
      },
      {
        "step": 3,
        "instruction": "Determine the argument using the quadrant of $z$.",
        "working": "$z$ lies in the second quadrant ($\\text{Re}(z)<0$, $\\text{Im}(z)>0$), so $\\theta = 180°-60° = 120° = \\dfrac{2\\pi}{3}$"
      },
      {
        "step": 4,
        "instruction": "Write the polar and exponential forms.",
        "working": "$z = 2\\!\\left(\\cos\\dfrac{2\\pi}{3}+i\\sin\\dfrac{2\\pi}{3}\\right) = 2e^{i\\cdot 2\\pi/3}$"
      }
    ],
    "answer": "$z = 2\\left(\\cos\\dfrac{2\\pi}{3}+i\\sin\\dfrac{2\\pi}{3}\\right) = 2e^{i2\\pi/3}$."
  },
  {
    "id": "complex-polar-worked-2",
    "title": "Multiplying and dividing in polar form",
    "difficulty": 2,
    "problem": "Given $z_1 = 6e^{i\\pi/4}$ and $z_2 = 2e^{i\\pi/12}$, find $\\dfrac{z_1}{z_2}$ in polar form and hence in Cartesian form.",
    "steps": [
      {
        "step": 1,
        "instruction": "Divide the moduli and subtract the arguments.",
        "working": "$\\dfrac{z_1}{z_2} = \\dfrac{6}{2}\\,e^{i(\\pi/4-\\pi/12)} = 3e^{i(\\pi/4-\\pi/12)}$"
      },
      {
        "step": 2,
        "instruction": "Simplify the argument.",
        "working": "$\\dfrac{\\pi}{4}-\\dfrac{\\pi}{12} = \\dfrac{3\\pi}{12}-\\dfrac{\\pi}{12} = \\dfrac{2\\pi}{12} = \\dfrac{\\pi}{6}$"
      },
      {
        "step": 3,
        "instruction": "Convert to Cartesian form.",
        "working": "$\\dfrac{z_1}{z_2} = 3e^{i\\pi/6} = 3\\!\\left(\\cos 30°+i\\sin 30°\\right) = 3\\!\\left(\\dfrac{\\sqrt{3}}{2}+\\dfrac{1}{2}i\\right) = \\dfrac{3\\sqrt{3}}{2}+\\dfrac{3}{2}i$"
      }
    ],
    "answer": "$\\dfrac{z_1}{z_2} = 3e^{i\\pi/6} = \\dfrac{3\\sqrt{3}}{2}+\\dfrac{3}{2}i$."
  },
  {
    "id": "complex-polar-worked-3",
    "title": "Using De Moivre's theorem to evaluate a power",
    "difficulty": 3,
    "problem": "Use De Moivre's theorem, $(\\cos\\theta+i\\sin\\theta)^n = \\cos(n\\theta)+i\\sin(n\\theta)$, to compute $(1+i)^{10}$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Write $1+i$ in polar form.",
        "working": "$|1+i| = \\sqrt{2}$, $\\arg(1+i) = 45°$, so $1+i = \\sqrt{2}\\,e^{i\\pi/4}$"
      },
      {
        "step": 2,
        "instruction": "Apply De Moivre's theorem.",
        "working": "$(1+i)^{10} = (\\sqrt{2})^{10}\\,e^{i \\cdot 10\\pi/4} = 2^5\\,e^{i5\\pi/2}$"
      },
      {
        "step": 3,
        "instruction": "Reduce the angle to a standard range.",
        "working": "$5\\pi/2 = 2\\pi+\\pi/2$, so $e^{i5\\pi/2} = e^{i\\pi/2} = \\cos 90°+i\\sin 90° = i$"
      },
      {
        "step": 4,
        "instruction": "Combine to find the final value.",
        "working": "$(1+i)^{10} = 32i$"
      },
      {
        "step": 5,
        "instruction": "Verify by squaring progressively.",
        "working": "$(1+i)^2 = 2i$, $(1+i)^4 = -4$, $(1+i)^8 = 16$, $(1+i)^{10} = 16 \\cdot (1+i)^2 = 16 \\cdot 2i = 32i$ ✓"
      }
    ],
    "answer": "$(1+i)^{10} = 32i$."
  }
]
