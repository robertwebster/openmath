    "id": "complex-roots-worked-1",
    "title": "Finding cube roots of a complex number",
    "difficulty": 1,
    "problem": "Find the three cube roots of $z = 8i$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Write $8i$ in exponential form.",
        "working": "$8i = 8e^{i\\pi/2}$, since $|8i|=8$ and $\\arg(8i) = 90° = \\pi/2$"
      },
      {
        "step": 2,
        "instruction": "Apply the $n$th root formula with $n=3$.",
        "working": "$z_k = 8^{1/3}\\,e^{i(\\pi/2+2\\pi k)/3} = 2e^{i(\\pi/6+2\\pi k/3)}, \\quad k = 0, 1, 2$"
      },
      {
        "step": 3,
        "instruction": "Compute each of the three roots.",
        "working": "$k=0$: $z_0 = 2e^{i\\pi/6} = 2(\\cos 30°+i\\sin 30°) = \\sqrt{3}+i$. $k=1$: $z_1 = 2e^{i5\\pi/6} = 2(\\cos 150°+i\\sin 150°) = -\\sqrt{3}+i$. $k=2$: $z_2 = 2e^{i3\\pi/2} = 2(\\cos 270°+i\\sin 270°) = -2i$"
      },
      {
        "step": 4,
        "instruction": "Check one of the roots.",
        "working": "$(-2i)^3 = -8i^3 = -8(-i) = 8i$ ✓"
      }
    ],
    "answer": "The three cube roots of $8i$ are $\\sqrt{3}+i$, $-\\sqrt{3}+i$, and $-2i$."
  },
  {
    "id": "complex-roots-worked-2",
    "title": "Deriving $\\cos 2\\theta$ and $\\sin 2\\theta$ using De Moivre's theorem",
    "difficulty": 2,
    "problem": "Use De Moivre's theorem to express $\\cos 2\\theta$ and $\\sin 2\\theta$ in terms of $\\sin\\theta$ and $\\cos\\theta$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Apply De Moivre's theorem with $n=2$.",
        "working": "$(\\cos\\theta+i\\sin\\theta)^2 = \\cos 2\\theta+i\\sin 2\\theta$"
      },
      {
        "step": 2,
        "instruction": "Expand the left side.",
        "working": "$(\\cos\\theta+i\\sin\\theta)^2 = \\cos^2\\theta + 2i\\cos\\theta\\sin\\theta + i^2\\sin^2\\theta = (\\cos^2\\theta-\\sin^2\\theta)+i(2\\cos\\theta\\sin\\theta)$"
      },
      {
        "step": 3,
        "instruction": "Equate real and imaginary parts.",
        "working": "$\\cos 2\\theta = \\cos^2\\theta-\\sin^2\\theta$ and $\\sin 2\\theta = 2\\sin\\theta\\cos\\theta$"
      }
    ],
    "answer": "$\\cos 2\\theta = \\cos^2\\theta-\\sin^2\\theta$ and $\\sin 2\\theta = 2\\sin\\theta\\cos\\theta$."
  },
  {
    "id": "complex-roots-worked-3",
    "title": "Proving the sum of the roots of unity is zero",
    "difficulty": 3,
    "problem": "Prove that $1+\\omega+\\omega^2+\\cdots+\\omega^{n-1} = 0$, where $\\omega = e^{2\\pi i/n}$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Recognise the left side as a geometric series and apply the geometric sum formula.",
        "working": "The left side has first term $1$, common ratio $\\omega$, and $n$ terms, so $1+\\omega+\\omega^2+\\cdots+\\omega^{n-1} = \\dfrac{1-\\omega^n}{1-\\omega}$"
      },
      {
        "step": 2,
        "instruction": "Simplify using $\\omega^n = 1$.",
        "working": "Since $\\omega^n = \\left(e^{2\\pi i/n}\\right)^n = e^{2\\pi i} = 1$: $\\dfrac{1-\\omega^n}{1-\\omega} = \\dfrac{1-1}{1-\\omega} = 0$, valid since $\\omega \\neq 1$ for $n \\geq 2$. $\\square$"
      }
    ],
    "answer": "$1+\\omega+\\omega^2+\\cdots+\\omega^{n-1} = 0$."
  }
]
