[
  {
    "id": "geometric-seq-worked-1",
    "title": "Finding the $n$th term and deciding if a limiting sum exists",
    "difficulty": 1,
    "problem": "A geometric sequence has first term $a = 12$ and common ratio $r = \\frac{1}{2}$. Find $T_5$ and the limiting sum $S_\\infty$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Find $T_5$.",
        "working": "$$T_5 = ar^4 = 12 \\times \\left(\\frac{1}{2}\\right)^4 = 12 \\times \\frac{1}{16} = \\frac{3}{4}$$"
      },
      {
        "step": 2,
        "instruction": "Check whether a limiting sum exists.",
        "working": "Since $|r| = \\frac{1}{2} < 1$, the series converges and $S_\\infty$ exists."
      },
      {
        "step": 3,
        "instruction": "Calculate $S_\\infty$.",
        "working": "$$S_\\infty = \\frac{a}{1 - r} = \\frac{12}{1 - \\frac{1}{2}} = \\frac{12}{\\frac{1}{2}} = 24$$"
      }
    ],
    "answer": "$T_5 = \\dfrac{3}{4}$ and $S_\\infty = 24$."
  },
  {
    "id": "geometric-seq-worked-2",
    "title": "Summing a finite geometric series",
    "difficulty": 2,
    "problem": "Find the sum of the first 8 terms of the series $5 + 10 + 20 + \\ldots$",
    "steps": [
      {
        "step": 1,
        "instruction": "Identify $a$ and $r$.",
        "working": "$a = 5$, $r = \\frac{10}{5} = 2$."
      },
      {
        "step": 2,
        "instruction": "Apply the sum formula $S_n = \\dfrac{a(r^n - 1)}{r - 1}$ since $r > 1$.",
        "working": "$$S_8 = \\frac{5(2^8 - 1)}{2 - 1} = 5(256 - 1) = 5 \\times 255 = 1275$$"
      }
    ],
    "answer": "$S_8 = 1275$."
  },
  {
    "id": "geometric-seq-worked-3",
    "title": "Finding $a$ and $r$ from two terms",
    "difficulty": 3,
    "problem": "The 3rd term of a geometric sequence is 18 and the 6th term is $\\frac{2}{3}$. Find $a$ and $r$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Set up equations using $T_n = ar^{n-1}$.",
        "working": "$$T_3 = ar^2 = 18 \\quad (1)$$ $$T_6 = ar^5 = \\frac{2}{3} \\quad (2)$$"
      },
      {
        "step": 2,
        "instruction": "Divide equation (2) by equation (1) to eliminate $a$.",
        "working": "$$\\frac{(2)}{(1)}: \\quad r^3 = \\frac{2/3}{18} = \\frac{2}{54} = \\frac{1}{27}$$ $$r = \\frac{1}{3}$$"
      },
      {
        "step": 3,
        "instruction": "Substitute back into equation (1) to find $a$.",
        "working": "From $(1)$: $a \\times \\left(\\frac{1}{3}\\right)^2 = 18 \\implies \\frac{a}{9} = 18 \\implies a = 162$."
      },
      {
        "step": 4,
        "instruction": "Find the limiting sum.",
        "working": "Since $|r| = \\frac{1}{3} < 1$: $$S_\\infty = \\frac{162}{1 - \\frac{1}{3}} = \\frac{162}{\\frac{2}{3}} = 243$$"
      }
    ],
    "answer": "$a = 162$, $r = \\dfrac{1}{3}$, and $S_\\infty = 243$."
  }
]
