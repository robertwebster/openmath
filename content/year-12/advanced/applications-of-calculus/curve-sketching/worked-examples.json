[
  {
    "id": "curve-sketching-worked-1",
    "title": "Finding stationary points and their nature",
    "difficulty": 1,
    "problem": "For $f(x) = x^3 - 3x^2 - 9x + 5$, find all stationary points and determine their nature.",
    "steps": [
      {
        "step": 1,
        "instruction": "Differentiate.",
        "working": "$$f'(x) = 3x^2 - 6x - 9 = 3(x^2 - 2x - 3) = 3(x - 3)(x + 1)$$"
      },
      {
        "step": 2,
        "instruction": "Solve $f'(x) = 0$.",
        "working": "$$3(x - 3)(x + 1) = 0 \\implies x = 3 \\text{ or } x = -1$$"
      },
      {
        "step": 3,
        "instruction": "Classify using the second derivative test.",
        "working": "$$f''(x) = 6x - 6$$ At $x = -1$: $f''(-1) = 6(-1) - 6 = -12 < 0$, a local maximum. At $x = 3$: $f''(3) = 6(3) - 6 = 12 > 0$, a local minimum."
      },
      {
        "step": 4,
        "instruction": "Find the $y$-values.",
        "working": "$$f(-1) = (-1)^3 - 3(-1)^2 - 9(-1) + 5 = -1 - 3 + 9 + 5 = 10$$ $$f(3) = 27 - 27 - 27 + 5 = -22$$"
      }
    ],
    "answer": "Local maximum at $(-1, 10)$ and local minimum at $(3, -22)$."
  },
  {
    "id": "curve-sketching-worked-2",
    "title": "Identifying points of inflection",
    "difficulty": 2,
    "problem": "Find the point of inflection of $g(x) = x^3 - 6x^2 + 12x - 4$ and describe the concavity on either side.",
    "steps": [
      {
        "step": 1,
        "instruction": "Find $g''(x)$.",
        "working": "$$g'(x) = 3x^2 - 12x + 12$$ $$g''(x) = 6x - 12$$"
      },
      {
        "step": 2,
        "instruction": "Solve $g''(x) = 0$.",
        "working": "$$6x - 12 = 0 \\implies x = 2$$"
      },
      {
        "step": 3,
        "instruction": "Check the sign change of $g''(x)$ either side of $x = 2$.",
        "working": "For $x < 2$, $g''(x) < 0$, so the curve is concave down. For $x > 2$, $g''(x) > 0$, so the curve is concave up. Concavity changes at $x = 2$, so there is a point of inflection."
      },
      {
        "step": 4,
        "instruction": "Find the $y$-value.",
        "working": "$$g(2) = 8 - 24 + 24 - 4 = 4$$"
      }
    ],
    "answer": "Point of inflection at $(2, 4)$."
  },
  {
    "id": "curve-sketching-worked-3",
    "title": "Curve analysis with an exponential function",
    "difficulty": 3,
    "problem": "For $f(x) = xe^{-x}$, find the stationary point and determine its nature.",
    "steps": [
      {
        "step": 1,
        "instruction": "Differentiate using the product rule with $u = x$ and $v = e^{-x}$.",
        "working": "$$f'(x) = e^{-x} + x \\cdot (-e^{-x}) = e^{-x}(1 - x)$$"
      },
      {
        "step": 2,
        "instruction": "Solve $f'(x) = 0$, noting $e^{-x} > 0$ for all $x$.",
        "working": "$$1 - x = 0 \\implies x = 1$$"
      },
      {
        "step": 3,
        "instruction": "Apply the second derivative test.",
        "working": "$$f''(x) = -e^{-x}(1 - x) + e^{-x}(-1) = e^{-x}(x - 2)$$ $$f''(1) = e^{-1}(1 - 2) = -\\frac{1}{e} < 0 \\implies \\text{local maximum}$$"
      },
      {
        "step": 4,
        "instruction": "Find the $y$-value.",
        "working": "$$f(1) = 1 \\cdot e^{-1} = \\frac{1}{e} \\approx 0.368$$"
      }
    ],
    "answer": "Local maximum at $\\left(1, \\dfrac{1}{e}\\right)$."
  }
]
