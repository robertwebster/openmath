    "difficulty": 3,
    "problem": "Find the equation of the tangent to $y = 3e^{2x}$ at the point where $x = 0$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Find the point on the curve.",
        "working": "At $x = 0$: $y = 3e^0 = 3 \\times 1 = 3$. Point: $(0,\\,3)$."
      },
      {
        "step": 2,
        "instruction": "Find the gradient using the derivative.",
        "working": "$$\\frac{dy}{dx} = 3 \\times 2\\,e^{2x} = 6e^{2x}$$ At $x = 0$: $\\dfrac{dy}{dx} = 6e^0 = 6$."
      },
      {
        "step": 3,
        "instruction": "Write the tangent equation using $y - y_1 = m(x - x_1)$ with $m = 6$ and $(x_1, y_1) = (0, 3)$.",
        "working": "$$y - 3 = 6(x - 0)$$ $$y = 6x + 3$$"
      }
    ],
    "answer": "$y = 6x + 3$"
  }
