    "difficulty": 3,
    "problem": "Evaluate $\\displaystyle\\int_0^{\\pi} \\sin^3 x \\cos x\\,dx$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Choose $u$ and find $du$.",
        "working": "Let $u = \\sin x$, so $du = \\cos x\\,dx$."
      },
      {
        "step": 2,
        "instruction": "Change the limits from $x$-values to $u$-values.",
        "working": "When $x = 0$, $u = \\sin 0 = 0$. When $x = \\pi$, $u = \\sin \\pi = 0$. Both limits map to $u = 0$, so the definite integral equals zero without needing to compute anything further."
      },
      {
        "step": 3,
        "instruction": "Confirm with the formal calculation.",
        "working": "$$\\int_0^{\\pi}\\sin^3 x\\cos x\\,dx = \\int_0^0 u^3\\,du = 0$$"
      }
    ],
    "answer": "$\\displaystyle\\int_0^{\\pi} \\sin^3 x \\cos x\\,dx = 0$"
  }
