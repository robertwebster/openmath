    "difficulty": 3,
    "problem": "Evaluate $\\displaystyle\\int_0^{\\pi/3} \\cos^2 x\\,dx$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Use the double-angle identity to rewrite $\\cos^2 x$.",
        "working": "$$\\cos^2 x = \\frac{1+\\cos 2x}{2}$$"
      },
      {
        "step": 2,
        "instruction": "Integrate.",
        "working": "$$\\int_0^{\\pi/3}\\cos^2 x\\,dx = \\int_0^{\\pi/3}\\frac{1+\\cos 2x}{2}\\,dx = \\left[\\frac{x}{2}+\\frac{\\sin 2x}{4}\\right]_0^{\\pi/3}$$"
      },
      {
        "step": 3,
        "instruction": "Substitute the limits and simplify.",
        "working": "$$= \\left(\\frac{\\pi/3}{2}+\\frac{\\sin(2\\pi/3)}{4}\\right) - (0+0) = \\frac{\\pi}{6}+\\frac{\\sqrt{3}/2}{4} = \\frac{\\pi}{6}+\\frac{\\sqrt{3}}{8}$$ $$\\approx 0.5236 + 0.2165 = 0.7401$$"
      }
    ],
    "answer": "$\\displaystyle\\int_0^{\\pi/3} \\cos^2 x\\,dx = \\frac{\\pi}{6}+\\frac{\\sqrt{3}}{8} \\approx 0.7401$"
  }
