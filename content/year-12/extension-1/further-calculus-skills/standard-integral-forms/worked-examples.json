    "title": "Inverse-sine form",
    "difficulty": 1,
    "problem": "Find $\\displaystyle\\int \\frac{5}{\\sqrt{25-x^2}}\\,dx$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Identify $a$ by writing $25 - x^2$ in the form $a^2 - x^2$.",
        "working": "Write $25 - x^2 = 5^2 - x^2$, so $a = 5$."
      },
      {
        "step": 2,
        "instruction": "Apply the standard form $\\int \\frac{1}{\\sqrt{a^2-x^2}}\\,dx = \\sin^{-1}\\!\\left(\\frac{x}{a}\\right) + C$.",
        "working": "$$\\int \\frac{5}{\\sqrt{25-x^2}}\\,dx = 5\\int \\frac{1}{\\sqrt{5^2-x^2}}\\,dx = 5\\sin^{-1}\\!\\left(\\frac{x}{5}\\right) + C$$"
      },
      {
        "step": 3,
        "instruction": "Check by differentiating the result.",
        "working": "$\\frac{d}{dx}\\left[5\\sin^{-1}\\!\\left(\\frac{x}{5}\\right)\\right] = 5 \\cdot \\frac{1/5}{\\sqrt{1-(x/5)^2}} = \\frac{1}{\\sqrt{1-x^2/25}} = \\frac{5}{\\sqrt{25-x^2}}$, which matches the integrand."
      }
    ],
    "answer": "$\\displaystyle\\int \\frac{5}{\\sqrt{25-x^2}}\\,dx = 5\\sin^{-1}\\!\\left(\\frac{x}{5}\\right) + C$"
  },
  {
    "id": "stdint-worked-2",
    "title": "Inverse-tangent form (definite integral)",
    "difficulty": 2,
    "problem": "Evaluate $\\displaystyle\\int_0^3 \\frac{1}{9+x^2}\\,dx$.",
    "steps": [
      {
        "step": 1,
        "instruction": "Identify $a$ by writing $9 + x^2$ in the form $a^2 + x^2$.",
        "working": "$9 + x^2 = 3^2 + x^2$, so $a = 3$."
      },
      {
        "step": 2,
        "instruction": "Apply the standard form $\\int \\frac{1}{a^2+x^2}\\,dx = \\frac{1}{a}\\tan^{-1}\\!\\left(\\frac{x}{a}\\right) + C$.",
        "working": "$$\\int_0^3 \\frac{1}{9+x^2}\\,dx = \\frac{1}{3}\\left[\\tan^{-1}\\!\\left(\\frac{x}{3}\\right)\\right]_0^3$$"
      },
      {
        "step": 3,
        "instruction": "Substitute the limits.",
        "working": "$$= \\frac{1}{3}\\left(\\tan^{-1}(1) - \\tan^{-1}(0)\\right) = \\frac{1}{3}\\left(\\frac{\\pi}{4} - 0\\right) = \\frac{\\pi}{12}$$"
      }
    ],
    "answer": "$\\displaystyle\\int_0^3 \\frac{1}{9+x^2}\\,dx = \\frac{\\pi}{12}$"
  },
  {
